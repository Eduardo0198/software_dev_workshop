<%- include('includes/head.ejs') %>
<%- include('includes/nav.ejs') %>

<section class="container my-5">
  <div class="card shadow-sm rounded-4 border-0">
    <div class="card-body p-4">
      <h2 class="mb-4">Servicios Web</h2>

      <p>En esta página usamos Google Maps JavaScript API para mostrar un mapa integrado.</p>

      <div id="map" style="width:100%; height:500px; border-radius: 16px; overflow:hidden;"></div>

      <h3 class="mt-4">¿Ventajas?</h3>
      <ul>
        <li>Rápida integración de funcionalidad avanzada sin construir todo desde cero.</li>
        <li>Mejora UX con mapas interactivos y datos de terceros.</li>
        <li>Acceso a servicios confiables y actualizados.</li>
      </ul>

      <h3 class="mt-3">¿Desventajas?</h3>
      <ul>
        <li>Dependencia de un servicio externo.</li>
        <li>Puede tener costo si se usa mucho tráfico.</li>
        <li>Necesitas manejar API keys y límites de cuota.</li>
      </ul>
    </div>
  </div>
</section>

<script>
  function initMap() {
    const ubicacion = { lat: 4.7110, lng: -74.0721 }; // Bogotá
    const map = new google.maps.Map(document.getElementById('map'), {
      center: ubicacion,
      zoom: 12
    });
    new google.maps.Marker({
      position: ubicacion,
      map,
      title: 'Bogotá'
    });
  }
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= apiKey %>&callback=initMap" async defer></script>

