<%- include('includes/head.ejs') %>
<%- include('includes/nav.ejs') %>

<section class="container my-5">
  <div class="card shadow-sm rounded-4 border-0">
    <div class="card-body p-4">
      <h2 class="mb-4"><%= titulo %></h2>

      <% if (mensaje) { %>
        <div class="alert alert-success"><%= mensaje %></div>
      <% } %>

      <div class="row">
        <div class="col-md-6 mb-4">
          <div class="card border-0 shadow-sm">
            <div class="card-body">
              <h5>Insertar nuevo personaje</h5>
              <form action="/procedimientos" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="accion" value="guardar">
                <div class="mb-3">
                  <label for="nombre" class="form-label">Nombre</label>
                  <input type="text" class="form-control" id="nombre" name="nombre" required>
                </div>
                <div class="mb-3">
                  <label for="descripcion" class="form-label">Descripción</label>
                  <textarea class="form-control" id="descripcion" name="descripcion" rows="2" required></textarea>
                </div>
                <div class="mb-3">
                  <label for="descripcion" class="form-label">Descripción</label>
                  <textarea class="form-control" id="descripcion" name="descripcion" rows="2" required></textarea>
                </div>
                <div class="mb-3">
                  <label for="tipo" class="form-label">Tipo</label>
                  <input type="text" class="form-control" id="tipo" name="tipo" required>
                </div>
                <div class="mb-3">
                  <label for="universo" class="form-label">Universo</label>
                  <input type="text" class="form-control" id="universo" name="universo" required>
                </div>
                <div class="mb-3">
                  <label for="imagen" class="form-label">URL de imagen</label>
                  <input type="url" class="form-control" id="imagen" name="imagen" required>
                </div>
                <button type="submit" class="btn btn-danger">Ejecutar sp_insertar_personaje</button>
              </form>
            </div>
          </div>
        </div>

        <div class="col-md-6 mb-4">
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
              <h5>Listar personajes por universo</h5>
              <form action="/procedimientos" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="accion" value="listar">
                <div class="mb-3">
                  <label for="universoListado" class="form-label">Universo</label>
                  <input type="text" class="form-control" id="universoListado" name="universo" value="<%= universo %>" placeholder="Dejar vacío para todos">
                </div>
                <button type="submit" class="btn btn-danger">Ejecutar sp_obtener_personajes_por_universo</button>
              </form>
            </div>
          </div>

          <div class="card border-0 shadow-sm">
            <div class="card-body">
              <h5>Contar personajes por universo</h5>
              <form action="/procedimientos" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="accion" value="contar">
                <div class="mb-3">
                  <label for="universoConteo" class="form-label">Universo</label>
                  <input type="text" class="form-control" id="universoConteo" name="universo" value="<%= universo %>" placeholder="Dejar vacío para todos">
                </div>
                <button type="submit" class="btn btn-danger">Ejecutar sp_contar_personajes_por_universo</button>
              </form>
            </div>
          </div>
        </div>
      </div>

      <% if (resultados && resultados.length) { %>
        <div class="card border-0 shadow-sm mt-4">
          <div class="card-body">
            <h5>Resultados</h5>
            <div class="table-responsive">
              <table class="table table-bordered table-striped">
                <thead>
                  <tr>
                    <% Object.keys(resultados[0]).forEach((col) => { %>
                      <th><%= col %></th>
                    <% }); %>
                  </tr>
                </thead>
                <tbody>
                  <% resultados.forEach((row) => { %>
                    <tr>
                      <% Object.values(row).forEach((value) => { %>
                        <td><%= value %></td>
                      <% }); %>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('includes/footer.ejs') %>
