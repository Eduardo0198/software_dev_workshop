<%- include('includes/head.ejs') %>
<%- include('includes/nav.ejs') %>

<section class="container my-5">
  <div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4">
      <h2 class="mb-4">Editar personaje</h2>

      <form action="/personajes/<%= personaje.id %>/editar" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-3">
          <label for="nombre" class="form-label">Nombre</label>
          <input type="text" class="form-control" id="nombre" name="nombre" value="<%= personaje.nombre %>" required>
        </div>

        <div class="mb-3">
          <label for="descripcion" class="form-label">Descripcion</label>
          <textarea class="form-control" id="descripcion" name="descripcion" rows="3" required><%= personaje.descripcion %></textarea>
        </div>

        <div class="mb-3">
          <label for="tipo" class="form-label">Tipo</label>
          <input type="text" class="form-control" id="tipo" name="tipo" value="<%= personaje.tipo %>" required>
        </div>

        <div class="mb-3">
          <label for="universo" class="form-label">Universo</label>
          <input type="text" class="form-control" id="universo" name="universo" value="<%= personaje.universo %>" required>
        </div>

        <div class="mb-3">
          <label for="imagen" class="form-label">URL de imagen</label>
          <input type="url" class="form-control" id="imagen" name="imagen" value="<%= personaje.imagen %>" required>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-danger">Guardar cambios</button>
          <a href="/personajes/<%= personaje.id %>" class="btn btn-outline-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</section>

<%- include('includes/footer.ejs') %>
